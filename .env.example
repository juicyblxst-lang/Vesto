# Required for real 0x quotes/execution
ZEROX_API_KEY=

# Optional production persistence. If omitted, social/portfolio write APIs fail closed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vesto

# Optional AI pressure testing. If omitted, the UI truthfully reports that AI is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Public RPC; replace with your provider if desired.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
